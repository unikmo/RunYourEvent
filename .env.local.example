# Public site URL used for canonical metadata / sitemap
NEXT_PUBLIC_SITE_URL=https://runyourevent.com

# Supabase — current system of record
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Firebase Firestore — server-side mirror for Volunteer Engine
# RunYourEvent already defaults to:
#   project: theantibalcony
#   database: (default)
#   mirror: enabled automatically when the two credentials below are present
# Keep these server-only. Do not expose them with NEXT_PUBLIC_ prefixes.
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@theantibalcony.iam.gserviceaccount.com
# Recommended on Vercel: base64-encode the complete PEM private key and use this variable.
FIREBASE_PRIVATE_KEY_BASE64=base64-encoded-private-key

# Optional overrides only if ever needed:
# RYE_FIREBASE_MIRROR_ENABLED=false
# FIREBASE_PROJECT_ID=theantibalcony
# FIREBASE_DATABASE_ID=(default)
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Anthropic — server-only
ANTHROPIC_API_KEY=your-anthropic-key
