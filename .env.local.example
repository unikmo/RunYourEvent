# Public site URL used for canonical metadata / sitemap
NEXT_PUBLIC_SITE_URL=https://runyourevent.com

# Supabase — current system of record
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Firebase Firestore — optional server-side mirror for Volunteer Engine
# Keep these server-only. Do not expose them with NEXT_PUBLIC_ prefixes.
RYE_FIREBASE_MIRROR_ENABLED=false
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# Recommended on Vercel: base64-encode the complete PEM private key and use this variable.
FIREBASE_PRIVATE_KEY_BASE64=base64-encoded-private-key
# Alternative for local development only if preferred:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Usually leave this as (default).
FIREBASE_DATABASE_ID=(default)

# Anthropic — server-only
ANTHROPIC_API_KEY=your-anthropic-key
